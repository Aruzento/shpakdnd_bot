[Unit]
Description=Observe Shpak DnD project changes; operator deployment required

[Path]
# Explicit directories: PathModified is not recursive. No generated/control files.
TriggerLimitIntervalSec=30
TriggerLimitBurst=100
PathModified=/opt/shpakdnd-bot/bot.py
PathModified=/opt/shpakdnd-bot/app
PathModified=/opt/shpakdnd-bot/app/db
PathModified=/opt/shpakdnd-bot/app/services
PathModified=/opt/shpakdnd-bot/app/handlers
PathModified=/opt/shpakdnd-bot/app/mini
PathModified=/opt/shpakdnd-bot/app/mini/events
PathModified=/opt/shpakdnd-bot/app/mini/ui
PathModified=/opt/shpakdnd-bot/app/mini/combat
PathModified=/opt/shpakdnd-bot/app/mini/combat/hero_abilities
PathModified=/opt/shpakdnd-bot/app/mini/effects
PathModified=/opt/shpakdnd-bot/app/mini/migrations
PathModified=/opt/shpakdnd-bot/app/mini/content
PathModified=/opt/shpakdnd-bot/app/mini/boss
PathModified=/opt/shpakdnd-bot/app/mini/boss/abilities
PathModified=/opt/shpakdnd-bot/app/mini/boss/boss_abilities
PathModified=/opt/shpakdnd-bot/app/mini/boss/content
Unit=shpakdnd-bot-update.service

PathModified=/opt/shpakdnd-bot/app/mini/tower
PathModified=/opt/shpakdnd-bot/app/mini/equipment
PathModified=/opt/shpakdnd-bot/app/mini/superadmin
PathModified=/opt/shpakdnd-bot/app/mini/titles

PathModified=/opt/shpakdnd-bot/app/mini/content/heroes
PathModified=/opt/shpakdnd-bot/app/mini/village
PathModified=/opt/shpakdnd-bot/app/mini/duels
PathModified=/opt/shpakdnd-bot/app/mini/mythic

[Install]
WantedBy=multi-user.target
