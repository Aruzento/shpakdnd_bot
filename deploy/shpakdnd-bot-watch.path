[Unit]
Description=Watch Shpak DnD project files

[Path]
PathModified=/opt/shpakdnd-bot/bot.py
PathModified=/opt/shpakdnd-bot/app
PathModified=/opt/shpakdnd-bot/app/db
PathModified=/opt/shpakdnd-bot/app/services
PathModified=/opt/shpakdnd-bot/app/handlers
PathModified=/opt/shpakdnd-bot/app/mini
Unit=shpakdnd-bot-update.service

[Install]
WantedBy=multi-user.target
